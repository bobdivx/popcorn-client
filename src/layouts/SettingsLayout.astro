---
import Layout from './Layout.astro';
import SettingsSidebar from '../components/settings/SettingsSidebar';
import SettingsMobileMenuTrigger from '../components/settings/SettingsMobileMenuTrigger';

interface Props {
  title?: string;
}

const { title = 'Paramètres - Popcorn Client' } = Astro.props;
---

<Layout title={title}>
  <div class="ds-page settings-page flex w-full" data-page="settings" data-tv-settings-container>
    <aside transition:persist="settings-sidebar" class="settings-sidebar-wrapper w-0 flex-shrink-0 md:w-72 xl:w-80 self-stretch">
      {/* idle : priorise le contenu principal, sidebar hydrate juste après */}
      <SettingsSidebar client:idle />
    </aside>
    <div
      class="settings-content-area flex-1 min-w-0 min-h-0 overflow-x-hidden overflow-y-auto pl-[max(0.75rem,env(safe-area-inset-left,0px))] pr-3 sm:px-6 md:px-6 pb-[env(safe-area-inset-bottom,0px)]"
      transition:name="settings-content"
      data-tv-settings-content
    >
      <div class="md:hidden h-14 shrink-0" aria-hidden />
      <slot />
    </div>
    <div class="settings-mobile-menu-trigger-host md:hidden">
      <SettingsMobileMenuTrigger client:idle />
    </div>
  </div>
</Layout>

<style is:global>
  /*
   * Rend <main> un conteneur flex avec overflow:hidden pour que settings-page
   * puisse utiliser flex:1 et remplir exactement la hauteur visible (viewport - navbar).
   */
  .app-main:has(.settings-page) {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Mobile : un seul scroll (la page), pas un nested overflow qui piège le doigt sur les cartes. */
  @media (max-width: 767px) {
    .app-main:has(.settings-page) {
      display: block;
      overflow: visible;
      height: auto;
    }
    .settings-page {
      display: block !important;
      min-height: 0;
      height: auto;
      flex: none;
    }
    .settings-content-area {
      overflow: visible !important;
      max-height: none;
    }
  }

  /* Fond de la page settings — adaptatif selon le thème / pack */
  .settings-page {
    background: #07070e;
  }
  [data-theme="light"] .settings-page {
    background: var(--ds-surface);
  }
  html[data-ui-pack="tesla"]:not([data-theme="dark"]) .settings-page {
    background: #e6e6e8;
  }
  html[data-ui-pack="tesla"][data-theme="dark"] .settings-page {
    background: var(--ds-surface, #111113);
  }

  /* ── Animations de navigation settings ── */
  @keyframes settings-content-enter {
    from {
      opacity: 0;
      transform: translateX(12px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes settings-content-exit {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  /* View transitions pour le contenu settings (X-axis slide comme le wizard) */
  ::view-transition-new(settings-content) {
    animation: settings-content-enter 0.26s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  ::view-transition-old(settings-content) {
    animation: settings-content-exit 0.16s ease both;
  }

  /* Pas d'animation si l'utilisateur préfère réduire le mouvement */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-new(settings-content),
    ::view-transition-old(settings-content) {
      animation: none;
    }
  }
</style>
