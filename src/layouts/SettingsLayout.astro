---
import Layout from './Layout.astro';
import TranscodeWarningBanner from '../components/settings/TranscodeWarningBanner';
import SettingsHubBack from '../components/settings/SettingsHubBack';
import '../styles/settings-hub.css';

interface Props {
  title?: string;
}

const { title = 'Paramètres - Popcorn Client' } = Astro.props;
---

<Layout title={title}>
  <!-- Warning banner pour transcodages lourds -->
  <TranscodeWarningBanner client:only="preact" />
  
  <div class="ds-page settings-page flex w-full" data-page="settings" data-tv-settings-container>
    <div
      class="settings-content-area flex-1 min-w-0 min-h-0 overflow-x-hidden overflow-y-auto pt-4"
      transition:name="settings-content"
      data-tv-settings-content
    >
      <SettingsHubBack client:load />
      <slot />
    </div>
  </div>
</Layout>

<style is:global>
  /*
   * Rend <main> un conteneur flex avec overflow:hidden pour que settings-page
   * puisse utiliser flex:1 et remplir exactement la hauteur visible (viewport - navbar).
   */
  /* Un seul scroll : la page. Un conteneur interne en overflow:hidden coupait le bas. */
  .app-main:has(.settings-page) {
    display: block;
    overflow: visible;
    height: auto;
  }
  .settings-page {
    display: block !important;
    height: auto !important;
    flex: none !important;
    overflow: visible !important;
  }
  .settings-content-area {
    overflow: visible !important;
    max-width: 100% !important;
    max-height: none !important;
    height: auto !important;
    padding-bottom: max(6rem, calc(4rem + env(safe-area-inset-bottom, 0px))) !important;
  }

  .settings-page {
    background: var(--page-bg);
  }

  /* ── Animations de navigation settings ── */
  @keyframes settings-content-enter {
    from {
      opacity: 0;
      transform: translateX(12px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes settings-content-exit {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  /* View transitions pour le contenu settings (X-axis slide comme le wizard) */
  ::view-transition-new(settings-content) {
    animation: settings-content-enter 0.26s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  ::view-transition-old(settings-content) {
    animation: settings-content-exit 0.16s ease both;
  }

  /* Pas d'animation si l'utilisateur préfère réduire le mouvement */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-new(settings-content),
    ::view-transition-old(settings-content) {
      animation: none;
    }
  }
</style>
