---
import '../styles/global.css';
import '../styles/design-system.css';
import '../styles/ui-packs.css';
import '../styles/editorial.css';
import { ClientRouter } from 'astro:transitions';
import ServerConnectionCheck from '../components/ServerConnectionCheck';
import Navbar from '../components/layout/Navbar';
import DemoExitBar from '../components/layout/DemoExitBar';
import TVNavigationProvider from '../components/tv/TVNavigationProvider';
import DebugPanel from '../components/debug/DebugPanel';
import WebOSBoot from '../components/webos/WebOSBoot.astro';
import TvViewportScript from '../components/tv/TvViewportScript.astro';
import {
  IS_STORE_BUILD,
  STORE_BLOCKED_ROUTE_PREFIXES,
  TORRENT_API_PATTERN_SOURCES,
} from '../lib/distribution';

interface Props {
  title?: string;
}

const { title = 'Popcornn' } = Astro.props;
const isWebOS = import.meta.env.WEBOS === 'true';
---

<!doctype html>
<html lang="fr" id="html-root" data-theme="dark" data-ui-pack="tesla" class="overflow-x-hidden" data-webos={isWebOS ? 'true' : undefined} data-dev={import.meta.env.DEV ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    {IS_STORE_BUILD && (
      <script
        is:inline
        define:vars={{ storeBlockedRoutes: STORE_BLOCKED_ROUTE_PREFIXES, storeApiPatterns: TORRENT_API_PATTERN_SOURCES }}
      >
        /* Version store (PUBLIC_DISTRIBUTION=play) : pas de routes ni d'appels réseau torrent. */
        (function () {
          window.__POPCORN_DISTRIBUTION__ = 'play';
          try {
            var p = (location.pathname || '/').replace(/\/+$/, '') || '/';
            if (p === '/torrents' || p.indexOf('/torrents/') === 0) {
              location.replace('/media' + location.search + location.hash);
              return;
            }
            for (var i = 0; i < storeBlockedRoutes.length; i++) {
              var b = storeBlockedRoutes[i];
              if (p === b || p.indexOf(b + '/') === 0) {
                location.replace('/dashboard');
                return;
              }
            }
          } catch (e) {}
          var res = storeApiPatterns.map(function (src) { return new RegExp(src); });
          function blocked(u) {
            try {
              var raw = typeof u === 'string' ? u : (u && u.url) || String(u);
              var url = new URL(raw, location.href);
              for (var j = 0; j < res.length; j++) { if (res[j].test(url.pathname)) return true; }
            } catch (e) {}
            return false;
          }
          var body = '{"success":false,"error":"NotAvailable","message":"Not available in this version."}';
          var origFetch = window.fetch;
          if (origFetch) {
            window.fetch = function (input, init) {
              if (blocked(input)) {
                return Promise.resolve(new Response(body, { status: 404, headers: { 'Content-Type': 'application/json' } }));
              }
              return origFetch.apply(this, arguments);
            };
          }
          if (window.XMLHttpRequest) {
            var origOpen = XMLHttpRequest.prototype.open;
            XMLHttpRequest.prototype.open = function (method, url) {
              if (blocked(url)) arguments[1] = 'data:application/json,' + encodeURIComponent(body);
              return origOpen.apply(this, arguments);
            };
          }
          if (window.EventSource) {
            var OrigES = window.EventSource;
            var GuardedES = function (url, cfg) {
              if (blocked(url)) throw new Error('NotAvailable');
              return new OrigES(url, cfg);
            };
            GuardedES.prototype = OrigES.prototype;
            window.EventSource = GuardedES;
          }
        })();
      </script>
    )}
    <script is:inline>
      /* Sortie d'urgence du mode démo, avant le chargement de l'app. */
      (function() {
        try {
          var q = new URLSearchParams(location.search);
          if (q.get('exitDemo') === '1') {
            localStorage.removeItem('popcorn_demo_mode');
            try { sessionStorage.setItem('popcorn_demo_leaving', '1'); } catch (e) {}
            try { localStorage.setItem('popcorn_intro_skipped', '1'); } catch (e2) {}
            location.replace(location.origin + '/');
            return;
          }
          var path = location.pathname || '';
          var demo = path === '/demo' || path.indexOf('/demo/') === 0 || localStorage.getItem('popcorn_demo_mode') === '1';
          if (demo) document.documentElement.setAttribute('data-show-demo-exit', '1');
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      #popcorn-demo-exit-static { display: none; }
      html[data-show-demo-exit] #popcorn-demo-exit-static {
        display: flex;
        position: fixed;
        z-index: 10002;
        left: 12px;
        right: 12px;
        bottom: max(12px, env(safe-area-inset-bottom));
        min-height: 48px;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #d97706;
        color: #fff;
        font: 600 16px/1.2 system-ui, sans-serif;
        text-decoration: none;
      }
    </style>
    <script is:inline>
      /* ── Anti-flash thème : doit s'exécuter AVANT toute CSS ── */
      (function() {
        try {
          var s = localStorage.getItem('popcorn_client_user_preferences');
          var t = 'dark';
          if (s) {
            var p = JSON.parse(s);
            if (p.language) document.documentElement.lang = p.language;
            t = p.theme || 'auto';
            if (p.uiPack) document.documentElement.dataset.uiPack = p.uiPack;
            else document.documentElement.dataset.uiPack = 'tesla';
          }
          if (t === 'auto') {
            var h = new Date().getHours();
            t = (h >= 7 && h < 20) ? 'light' : 'dark';
          }
          document.documentElement.dataset.theme = t;
        } catch(e) {}
      })();
    </script>
    <script is:inline>
      // En tête de console : URL et temps de chargement (après load)
      (function() {
        function logPageInfo() {
          var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
          var loadMs = nav && nav.loadEventEnd ? Math.round(nav.loadEventEnd - nav.fetchStart) : 0;
          console.clear();
          console.log('%c[Page] ' + location.href, 'font-weight: bold');
          console.log('%c[Temps de chargement] ' + loadMs + ' ms', 'font-weight: bold');
        }
        if (document.readyState === 'complete') logPageInfo();
        else window.addEventListener('load', logPageInfo);
      })();
    </script>
    <meta name="description" content="Popcornn - Client léger pour serveur Popcornn" />
    <!-- Application privée (pas la vitrine) : ne pas indexer. robots.txt reste ouvert pour que les moteurs voient ce noindex. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <!-- Android TV / Google TV : viewport CSS 1920×1080 comme webOS (no-op ailleurs) -->
    <TvViewportScript />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#3b6ae1" />
    <title>{title}</title>
    {!isWebOS && <ClientRouter />}
    <WebOSBoot />
    <script is:inline>
      /* Détection Tesla / QtCarBrowser dès le chargement (lecteur voiture). */
      (function () {
        try {
          var ua = navigator.userAgent || '';
          if (/Tesla|QtCarBrowser|QtWebEngine/i.test(ua)) {
            document.documentElement.setAttribute('data-tesla-browser', 'true');
            document.documentElement.setAttribute('data-car-player', 'true');
            sessionStorage.setItem('popcorn_is_tesla', '1');
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      /* Écran de chargement UNIQUE (#popcorn-loading-fallback) : splash de démarrage, navigations
         View Transitions, vérifs auth/setup/serveur, données de l'accueil, gardes de route.
         Script dans le head : existe avant les îlots Preact et survit au swap du body.
         « holds » : l'écran reste visible tant qu'au moins un hold est actif (plafond par hold,
         jamais bloqué) — évite la cascade splash → loader → skeleton (flashs / re-montages).
         ES5 uniquement (anciens webOS). API : src/lib/boot/pageLoader.ts. */
      (function () {
        var holds = {};
        var timers = {};
        var appReady = false;
        function el() { return document.getElementById('popcorn-loading-fallback'); }
        function hasHolds() {
          var now = Date.now();
          for (var k in holds) {
            if (Object.prototype.hasOwnProperty.call(holds, k)) {
              if (holds[k] > now) return true;
              delete holds[k];
            }
          }
          return false;
        }
        function setMsg(text) {
          var m = document.getElementById('popcorn-loading-msg');
          if (!m) return;
          if (text) {
            m.textContent = String(text).substring(0, 160);
            m.style.display = '';
          } else {
            m.textContent = '';
            m.style.display = 'none';
          }
        }
        function show() {
          var n = el();
          if (!n) return;
          n.style.display = '';
          n.style.opacity = '1';
          n.style.transition = '';
        }
        function hide() {
          if (hasHolds()) return;
          var n = el();
          if (!n || n.style.display === 'none') return;
          n.style.opacity = '0';
          n.style.transition = 'opacity 0.15s ease';
          setTimeout(function () {
            if (n.style.opacity === '0' && !hasHolds()) {
              n.style.display = 'none';
              setMsg(null);
            }
          }, 150);
        }
        function release(key) {
          if (timers[key]) { clearTimeout(timers[key]); delete timers[key]; }
          if (!Object.prototype.hasOwnProperty.call(holds, key)) return;
          delete holds[key];
          if (appReady && !hasHolds()) hide();
        }
        function hold(key, maxMs) {
          var ms = typeof maxMs === 'number' && maxMs > 0 ? maxMs : 20000;
          holds[key] = Date.now() + ms;
          if (timers[key]) clearTimeout(timers[key]);
          timers[key] = setTimeout(function () { release(key); }, ms + 20);
          show();
        }
        /* Route logique (http : /dashboard ; file:// webOS : …/dashboard.html). */
        function route() {
          var p = (location.pathname || '/').replace(/\/+$/, '') || '/';
          var m = p.match(/\/([^\/]+)\.html?$/i);
          if (m) p = m[1].toLowerCase() === 'index' ? '/' : '/' + m[1].toLowerCase();
          return p;
        }
        function holdForRoute() {
          var r = route();
          /* IndexRedirect (auth / setup / serveur, puis intro) relâche ce hold. */
          if (r === '/' || r === '/demo') hold('index-boot', 60000);
          /* Accueil : un seul écran jusqu'aux premières données (pas de skeleton intermédiaire). */
          if (r === '/dashboard') {
            window.__popcornHomeReady = false;
            hold('home-data', 15000);
          }
        }
        holdForRoute();
        document.addEventListener('astro:before-preparation', function () {
          appReady = false;
          show();
        });
        document.addEventListener('astro:after-swap', function () {
          show();
          holdForRoute();
        });
        /* page-load : léger délai pour laisser les îlots Preact peindre ; popcorn-app-ready masque dès que l’app est prête. */
        document.addEventListener('astro:page-load', function () {
          setTimeout(function () { appReady = true; hide(); }, 120);
        });
        window.addEventListener('popcorn-app-ready', function () { appReady = true; hide(); });
        window.__popcornShowPageLoader = show;
        window.__popcornHidePageLoader = hide;
        window.__popcornHoldPageLoader = hold;
        window.__popcornReleasePageLoader = release;
        window.__popcornSetPageLoaderMessage = setMsg;
        window.__popcornPageLoaderAppReady = function () { return appReady; };
      })();
    </script>
    <script is:inline>
      /* ── Listeners persistants : sync multi-onglets · auto selon l’heure · View Transitions ── */
      (function() {
        var DAY_START = 7;
        var NIGHT_START = 20;
        var timer;
        function resolveAuto() {
          var h = new Date().getHours();
          return (h >= DAY_START && h < NIGHT_START) ? 'light' : 'dark';
        }
        function applyStoredTheme() {
          try {
            var s = localStorage.getItem('popcorn_client_user_preferences');
            var t = 'dark';
            var pack = 'tesla';
            if (s) {
              var p = JSON.parse(s);
              t = p.theme || 'auto';
              if (p.uiPack) pack = p.uiPack;
            }
            if (t === 'auto') t = resolveAuto();
            document.documentElement.dataset.theme = t;
            document.documentElement.dataset.uiPack = pack;
          } catch(e) {}
        }
        function msUntilSwitch() {
          var now = new Date();
          var next = new Date(now.getTime());
          var h = now.getHours();
          if (h >= DAY_START && h < NIGHT_START) next.setHours(NIGHT_START, 0, 0, 0);
          else if (h < DAY_START) next.setHours(DAY_START, 0, 0, 0);
          else {
            next.setDate(next.getDate() + 1);
            next.setHours(DAY_START, 0, 0, 0);
          }
          return Math.max(1000, next.getTime() - now.getTime());
        }
        function scheduleAuto() {
          if (timer) clearTimeout(timer);
          var pref = 'auto';
          try {
            var s = localStorage.getItem('popcorn_client_user_preferences');
            if (s) pref = JSON.parse(s).theme || 'auto';
          } catch(e) {}
          if (pref !== 'auto') return;
          timer = setTimeout(function() {
            applyStoredTheme();
            try { window.dispatchEvent(new CustomEvent('popcorn-theme-changed')); } catch(e) {}
            scheduleAuto();
          }, msUntilSwitch());
        }
        window.addEventListener('storage', function(e) {
          if (e.key === 'popcorn_client_user_preferences') {
            applyStoredTheme();
            scheduleAuto();
          }
        });
        window.addEventListener('popcorn-theme-changed', function() {
          scheduleAuto();
        });
        document.addEventListener('astro:after-swap', function() {
          applyStoredTheme();
          scheduleAuto();
        });
        scheduleAuto();
      })();
    </script>
    <!-- Google Fonts : désactivés sur webOS (file://) pour éviter blocage réseau et écran noir -->
    {!isWebOS && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Josefin+Sans:wght@100;200;300;400&family=Jost:wght@200;300;400;500&family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript>
          <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Josefin+Sans:wght@100;200;300;400&family=Jost:wght@200;300;400;500&family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet" />
        </noscript>
      </>
    )}
    <script>
      // Images TMDB : tailles adaptées, premières cartes prioritaires, cache persistant IndexedDB
      // dans les apps (Tauri, webOS natif) où le Service Worker n'est pas utilisable (voir imageCache.ts).
      import { installImageCache } from '../lib/media/imageCache';
      installImageCache();
    </script>
    <script>
      // Stage D : URLs de lecture signees (jeton media) pour <video>/hls.js/Chromecast/<img>.
      import { installMediaUrlSigning } from '../lib/streaming/mediaToken';
      installMediaUrlSigning();
    </script>
  </head>
  <body class="min-h-screen bg-page flex flex-col overflow-x-hidden">
    <script is:inline>
      (function() {
        var ua = navigator.userAgent || '';
        var w = window.innerWidth, h = window.innerHeight;
        var isTauri = typeof window.__TAURI_INTERNALS__ !== 'undefined';
        var tauriMeta = isTauri ? window.__TAURI_METADATA__ : null;
        var tauriPlatform = tauriMeta ? (tauriMeta.platform || tauriMeta.os || '') : '';
        var isTauriAndroidTV = isTauri && /android/i.test(tauriPlatform) && w >= 960 && h >= 540;
        var isTauriFallback = isTauri && !tauriMeta && w >= 1280 && h >= 720;
        var isAndroidTVUA = /Android.*TV|TV.*Android|GoogleTV|FireTV|AFT[A-Z]|Chromecast|SHIELD/i.test(ua);
        var isTVGeneric = /\bTV\b/i.test(ua) && !/iPhone|iPad|Mobile/i.test(ua);
        var isOtherTV = /webOS|Web0S/i.test(ua) || /AppleTV|Apple TV/i.test(ua);
        var isAndroidBrowserTV = /Android/i.test(ua) && w >= 1280 && h >= 720 && w > h;
        // App Android sur TV (jeton UA posé par l'activité native) / viewport 1920 forcé (TvViewportScript)
        // / Android sans écran tactile ni pointeur (télécommande seule) : TV quel que soit le modèle.
        var isNativeAndroidTV = /PopcornnTV/i.test(ua)
          || document.documentElement.hasAttribute('data-tv-viewport')
          || (/Android/i.test(ua) && (navigator.maxTouchPoints || 0) === 0
            && !!window.matchMedia && window.matchMedia('(pointer: none)').matches);
        var isForcedTV = window.location.search.indexOf('tv=1') !== -1;
        var isWebOSBuild = document.documentElement.getAttribute('data-webos') === 'true';
        // App « simple » / navigateur TV : pas de build WEBOS, on se base sur l’UA + APIs LG.
        var isWebOSRuntime = /webOS|Web0S|WebAppManager|NetCast/i.test(ua)
          || typeof window.webOS !== 'undefined'
          || typeof window.PalmSystem !== 'undefined';
        var isWebOS = isWebOSBuild || isWebOSRuntime;
        var isTV = isNativeAndroidTV || isTauriAndroidTV || isTauriFallback || isAndroidTVUA || isTVGeneric || isOtherTV || isAndroidBrowserTV || isForcedTV || isWebOS;
        if (isTV) {
          document.documentElement.setAttribute('data-tv-platform', 'true');
          try { sessionStorage.setItem('popcorn_is_tv', '1'); } catch (e) {}
        }
        if (isWebOS) {
          document.documentElement.setAttribute('data-webos', 'true');
          try { sessionStorage.setItem('popcorn_is_webos', '1'); } catch (e) {}
        }
        // Thème éditorial : web, mobile et TV/webOS (jamais en mode voiture /car*)
        var applyEditorial = function () {
          var root = document.documentElement;
          var p = location.pathname || '';
          var off = /^\/car(\/|$)/.test(p); // éditorial partout sauf mode voiture
          if (off) root.removeAttribute('data-editorial'); else root.setAttribute('data-editorial', 'true');
        };
        applyEditorial();
        document.addEventListener('astro:after-swap', function () {
          if (isTV) document.documentElement.setAttribute('data-tv-platform', 'true');
          if (isWebOS) document.documentElement.setAttribute('data-webos', 'true');
          applyEditorial();
        });
      })();
    </script>
    <script is:inline>
      // Mesure la largeur reelle de la scrollbar verticale du viewport et l'expose comme
      // variable CSS --scrollbar-width-real. Vaut 0 si le viewport n'a pas de scrollbar
      // visible (overlay scrollbars OU contenu plus court que la fenetre).
      // Utilisee par le zoom 80% (global.css) pour caler la largeur du body sur la
      // zone visible (100vw - scrollbar), sans depassement ni colonne vide.
      (function() {
        var osScrollbarWidth = null;
        function getOsScrollbarWidth() {
          if (osScrollbarWidth !== null) return osScrollbarWidth;
          var probe = document.createElement('div');
          probe.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:100px;height:100px;overflow:scroll;visibility:hidden;';
          document.documentElement.appendChild(probe);
          osScrollbarWidth = probe.offsetWidth - probe.clientWidth;
          document.documentElement.removeChild(probe);
          if (!isFinite(osScrollbarWidth) || osScrollbarWidth < 0) osScrollbarWidth = 0;
          return osScrollbarWidth;
        }
        function update() {
          // Largeur reelle = innerWidth - clientWidth de l'element scrollant (html ou body).
          // Methode robuste : prendre le max entre la mesure reelle et la mesure OS si un
          // scroll vertical est present.
          var docEl = document.documentElement;
          var win = window.innerWidth || docEl.clientWidth;
          var measured = win - docEl.clientWidth;
          var sw = measured > 0 ? measured : 0;
          // Si la page peut scroller verticalement et qu'on n'a rien mesure, prendre la valeur OS.
          if (sw === 0 && docEl.scrollHeight > docEl.clientHeight) {
            sw = getOsScrollbarWidth();
          }
          docEl.style.setProperty('--scrollbar-width-real', sw + 'px');
        }
        update();
        window.addEventListener('resize', update, { passive: true });
        // Re-mesurer apres le rendu initial des composants Preact (qui peuvent grandir la page).
        if ('ResizeObserver' in window) {
          var ro = new ResizeObserver(update);
          ro.observe(document.documentElement);
        }
        // Filet de securite : reverifier apres quelques tics de rendu.
        setTimeout(update, 100);
        setTimeout(update, 500);
        setTimeout(update, 1500);
      })();
    </script>
    <script is:inline>
      // Placeholder: les handlers seront enregistres apres que le DOM du fallback existe
      window._popcornShowError = function(msg) {
        var fallback = document.getElementById('popcorn-loading-fallback');
        var errEl = document.getElementById('popcorn-loading-error');
        if (!fallback || !errEl || fallback.style.display === 'none') return;
        var s = String(msg).substring(0, 300);
        errEl.textContent = s;
        errEl.style.display = 'block';
      };
    </script>
    <!-- Indicateur de chargement immédiat — même composition que DsLoader page (éditorial) -->
    <div id="popcorn-loading-fallback" class="fixed inset-0 z-[9999] overflow-hidden" aria-hidden="true" transition:persist="popcorn-loading-fallback" style="background:#0c0d10;color:#f4f1ec">
      <style>
        /* Inline critique avant editorial.css — même langage que .ed-loader--page */
        #popcorn-loading-fallback .plb{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;text-align:center;padding:0 1.5rem}
        #popcorn-loading-fallback .plb-k{letter-spacing:.42em;text-transform:uppercase;font-size:clamp(12px,1.15vw,22px);opacity:.6;font-family:'Jost',sans-serif;font-weight:300}
        #popcorn-loading-fallback .plb-t{letter-spacing:.32em;text-transform:uppercase;font-size:2rem;font-size:clamp(28px,3.4vw,64px);font-size:min(clamp(28px,3.4vw,64px),calc((100vw - 4rem) / 9.5));font-weight:300;font-family:'Josefin Sans','Jost',sans-serif;margin:0;padding-left:.32em;box-sizing:border-box;max-width:100%}
        #popcorn-loading-fallback .plb-l{position:relative;width:120px;height:1px;background:rgba(242,84,91,.35);overflow:hidden}
        #popcorn-loading-fallback .plb-l::after{content:'';position:absolute;inset:0;width:40%;background:#f2545b;animation:plb-run 1.4s cubic-bezier(.2,.7,.2,1) infinite}
        @keyframes plb-run{from{transform:translateX(-100%)}to{transform:translateX(250%)}}
        @media (prefers-reduced-motion: reduce){#popcorn-loading-fallback .plb-l::after{animation:none;width:100%}}
        #popcorn-loading-fallback .pl-boot-error{color:#f2545b;border:1px solid rgba(242,84,91,.4)}
        #popcorn-loading-fallback .plb-m{margin:0;max-width:min(32rem,100%);font-family:'Jost',sans-serif;font-weight:300;font-size:12px;font-size:clamp(11px,.9vw,18px);letter-spacing:.24em;text-transform:uppercase;color:rgba(244,241,236,.6);text-align:center;overflow-wrap:anywhere}
        #popcorn-loading-fallback .plb-x{position:absolute;left:0;right:0;top:calc(50% + 5.5rem);display:flex;flex-direction:column;align-items:center;gap:.75rem;padding:0 1.5rem;text-align:center}
      </style>
      <div class="plb" role="status" aria-busy="true">
        <div class="plb-k">Popcornn</div>
        <h1 class="plb-t">Chargement</h1>
        <div class="plb-l"></div>
      </div>
      <!-- Infos secondaires sous le bloc centré (ne décalent jamais le titre du centre de l'écran) -->
      <div class="plb-x">
        <p id="popcorn-loading-msg" class="plb-m" aria-live="polite" style="display: none;"></p>
        <p id="popcorn-loading-hint" class="pl-boot-hint text-sm mt-2 max-w-xs text-center hidden" style="display: none;">Si rien ne s&#39;affiche, quittez et rouvrez l&#39;app.</p>
        <p id="popcorn-loading-error" class="pl-boot-error mt-3 max-w-lg text-center px-3 py-2 text-sm font-medium hidden" style="display: none;"></p>
      </div>
    </div>
    <a id="popcorn-demo-exit-static" href="/?exitDemo=1">Quitter le mode démo</a>
    <TVNavigationProvider client:only="preact" />
    <ServerConnectionCheck client:only="preact" />
    <Navbar client:only="preact" />
    <DemoExitBar client:only="preact" />
    <DebugPanel client:only="preact" />
    <!-- Main content -->
    <main class="app-main flex-1 w-full overflow-x-hidden safe-area-top" style="padding-top: calc(4rem + var(--safe-area-inset-top));">
      <slot />
    </main>
    <style>
      /* Aligné sur la navbar : h-14 / sm:h-16 / tv:h-20 — pas d’espace mort sous le header */
      @media (max-width: 639px) {
        .app-main {
          padding-top: calc(3.5rem + var(--safe-area-inset-top)) !important;
        }
      }
      @media (min-width: 640px) {
        .app-main {
          padding-top: calc(4rem + var(--safe-area-inset-top)) !important;
        }
      }
      @media (min-width: 1280px) {
        .app-main {
          padding-top: calc(5rem + var(--safe-area-inset-top)) !important;
        }
      }
      body:has([data-demo-exit-bar]) .app-main {
        padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
      }
    </style>
    <script is:inline>
      // Cache d'images durable (affiches / backdrops / logos TMDB) via un Service Worker dédié
      // qui n'intercepte QUE image.tmdb.org (voir public/img-cache-sw.js).
      // Uniquement en https hors Tauri. Les apps (Tauri, webOS natif http://127.0.0.1 dont le cache SW
      // est vidé à chaque fermeture) utilisent le cache IndexedDB de src/lib/media/imageCache.ts.
      // Désactivable : localStorage.popcorn_img_sw = 'off' (ou popcorn_img_cache = 'idb' pour forcer le cache JS).
      (function() {
        try {
          if (!('serviceWorker' in navigator) || !('caches' in window)) return;
          var loc = window.location;
          if (loc.protocol !== 'https:') return;
          if ('__TAURI_INTERNALS__' in window || '__TAURI__' in window || /(^|\.)tauri\.localhost$/i.test(loc.hostname)) return;
          var sw = navigator.serviceWorker;
          var forced = localStorage.getItem('popcorn_img_cache');
          if (localStorage.getItem('popcorn_img_sw') === 'off' || forced === 'idb' || forced === 'off') {
            sw.getRegistrations().then(function(regs) {
              regs.forEach(function(r) {
                var w = r.active || r.waiting || r.installing;
                if (w && String(w.scriptURL).indexOf('/img-cache-sw.js') !== -1) r.unregister();
              });
            }).catch(function() {});
            return;
          }
          var started = false;
          var register = function() {
            if (started) return;
            started = true;
            // ?v= : le script est servi « immutable » (nginx/CDN) → incrémenter v à chaque
            // modification de public/img-cache-sw.js pour que la mise à jour soit prise en compte.
            sw.register('/img-cache-sw.js?v=3', { scope: '/' }).then(function() {
              // 1re visite : sans ça, la page (et toute la session ClientRouter) restait souvent
              // non contrôlée → aucune image mise en cache avant la visite suivante.
              return sw.ready.then(function(reg) {
                if (!sw.controller && reg && reg.active) reg.active.postMessage({ type: 'popcorn-img-claim' });
              });
            }).catch(function() {});
          };
          // Tôt (après load, ou 3 s au plus) : plus d'attente d'un « idle » qui n'arrive jamais sur appareil lent.
          setTimeout(register, 3000);
          if (document.readyState === 'complete') setTimeout(register, 200);
          else window.addEventListener('load', function() { setTimeout(register, 200); }, { once: true });
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // Intercepter les routes /player/* et rediriger vers /player avec l'ID en query param
      // Cela permet de gérer les routes dynamiques en mode static
      (function() {
        if (typeof window === 'undefined') return;
        const pathname = window.location.pathname;
        const playerMatch = pathname.match(/\/player\/(.+)$/);
        if (!playerMatch || !playerMatch[1]) return;
        const id = playerMatch[1];
        if (window.location.search.includes('id=') || window.location.search.includes('contentId=')) return;
        const isFile = window.location.protocol === 'file:';
        const target = isFile ? 'player.html?id=' + encodeURIComponent(id) : '/player?id=' + encodeURIComponent(id);
        window.location.replace(target);
      })();

      // Enregistrer les pieges a erreurs (DOM dispo ici) + masquer le fallback quand l'app a rendu
      (function() {
        console.log('[Popcorn] Script bas de page execute');
        var fallback = document.getElementById('popcorn-loading-fallback');
        var errEl = document.getElementById('popcorn-loading-error');
        var hint = document.getElementById('popcorn-loading-hint');
        function showError(msg) {
          console.error('[Popcorn] showError:', msg);
          if (window._popcornShowError) window._popcornShowError(msg);
        }
        window.onerror = function(m, src, line, col, err) {
          var msg = (err && err.message) || m || 'script';
          if (src) msg += ' | ' + src + (line ? ':' + line : '');
          showError('Erreur: ' + msg);
          return false;
        };
        window.onunhandledrejection = function(e) {
          showError('Erreur: ' + ((e.reason && (e.reason.message || String(e.reason))) || 'promise'));
        };
        window.addEventListener('error', function(e) {
          if (e.target && (e.target.tagName === 'SCRIPT' || e.target.tagName === 'LINK')) {
            var ref = e.target.src || e.target.href || '?';
            console.error('[Popcorn] Resource load failed:', ref);
            showError('Chargement bloque: ' + ref);
          }
        }, true);
        function hide() {
          if (window.__popcornHidePageLoader) {
            window.__popcornHidePageLoader();
            return;
          }
          if (!fallback) return;
          fallback.style.opacity = '0';
          fallback.style.transition = 'opacity 0.15s ease';
          setTimeout(function() { fallback.style.display = 'none'; }, 150);
        }
        /* Ne plus court-circuiter via sessionStorage : le splash doit rester
           visible à chaque chargement / navigation jusqu'à ready. */
        window.addEventListener('popcorn-app-ready', hide);
        /* Si l'app ne monte pas, le bouton de sortie reste cliquable au-dessus du voile. */
        setTimeout(function() {
          try {
            if (document.querySelector('[data-demo-exit-bar]')) return;
            var path = location.pathname || '';
            var demo = path === '/demo' || path.indexOf('/demo/') === 0 || localStorage.getItem('popcorn_demo_mode') === '1';
            if (!demo || document.getElementById('popcorn-demo-exit-fallback')) return;
            var lang = (document.documentElement.lang || 'fr').toLowerCase();
            var btn = document.createElement('button');
            btn.id = 'popcorn-demo-exit-fallback';
            btn.type = 'button';
            btn.setAttribute('data-demo-exit-bar', '');
            btn.textContent = lang.indexOf('en') === 0 ? 'Exit demo mode' : 'Quitter le mode démo';
            btn.style.cssText = 'position:fixed;z-index:10001;left:12px;right:12px;bottom:max(12px,env(safe-area-inset-bottom));min-height:48px;border:0;border-radius:12px;background:#d97706;color:#fff;font:600 16px/1.2 system-ui,sans-serif;';
            btn.onclick = function() {
              try { localStorage.removeItem('popcorn_demo_mode'); } catch (e) {}
              try { sessionStorage.setItem('popcorn_demo_leaving', '1'); } catch (e2) {}
              try { localStorage.setItem('popcorn_intro_skipped', '1'); } catch (e3) {}
              location.replace(location.origin + '/');
            };
            document.body.appendChild(btn);
          } catch (e) {}
        }, 1500);
        var isDev = document.documentElement.getAttribute('data-dev') === 'true';
        var hintDelay = isDev ? 15000 : 8000;
        var slowMsgDelay = isDev ? 20000 : 5000;
        // Écran unique : il peut rester affiché volontairement (données de l'accueil, serveur lent).
        // Les messages « bloqué » ne concernent que le cas où l'app n'a jamais démarré.
        function appStarted() {
          try { return !!(window.__popcornPageLoaderAppReady && window.__popcornPageLoaderAppReady()); } catch (e) { return false; }
        }
        setTimeout(function() {
          if (appStarted()) return;
          if (fallback && fallback.style.display !== 'none' && hint) hint.style.display = 'block';
        }, hintDelay);
        setTimeout(function() {
          if (appStarted()) return;
          if (!fallback || fallback.style.display === 'none') return;
          if (!errEl || !errEl.textContent) {
            var isWebOSEnv = document.documentElement.getAttribute('data-webos') === 'true';
            showError(isWebOSEnv
              ? 'Aucune erreur capturee. Sur webOS (file://) les modules JS peuvent etre bloques. Quittez et rouvrez l app.'
              : 'Chargement lent. Si la page ne s\'affiche pas, rechargez.');
          }
        }, slowMsgDelay);
        // Sur webOS : app-webos.js est chargé par WebOSBoot.astro (après tap utilisateur, sans type=module)
      })();
    </script>
  </body>
</html>
