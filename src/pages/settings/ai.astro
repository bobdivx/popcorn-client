---
import SettingsLayout from '../../layouts/SettingsLayout.astro';
import AiSettingsPanel from '../../components/settings/AiSettingsPanel';
import DsPageHeader from '../../components/ui/DsPageHeader';
---

<SettingsLayout title="Assistance - Popcorn">
  <div class="ds-container max-w-5xl py-4 sm:py-6 px-3 sm:px-6">
    <DsPageHeader
      client:only="preact"
      titleKey="ai.title"
      subtitleKey="ai.subtitle"
    />
    <AiSettingsPanel client:only="preact" />
  </div>
</SettingsLayout>
