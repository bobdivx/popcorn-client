---
import SettingsLayout from '../../layouts/SettingsLayout.astro';
import PermissionGuard from '../../components/ui/PermissionGuard';
import DsPageHeader from '../../components/ui/DsPageHeader';
import WebOSDeploymentPanel from '../../components/settings/WebOSDeploymentPanel';
---

<SettingsLayout title="Déploiement WebOS - Popcorn Client">
  <div class="ds-container max-w-5xl py-4 sm:py-6 px-3 sm:px-6">
    <DsPageHeader
      client:only="preact"
      titleKey="settingsPages.webosDeployment.title"
      subtitleKey="settingsPages.webosDeployment.subtitle"
    />
    <PermissionGuard client:only="preact" permission="settings.server">
      <WebOSDeploymentPanel client:only="preact" />
    </PermissionGuard>
  </div>
</SettingsLayout>
